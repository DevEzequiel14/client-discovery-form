---
type Props = {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel';
  value?: string;
  placeholder?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  optionalLabel?: string;
  requiredLabel?: string;
  autocomplete?: string;
  inputmode?: 'text' | 'email' | 'tel';
};

const {
  id,
  name,
  label,
  type = 'text',
  value = '',
  placeholder,
  hint,
  error,
  required = false,
  optionalLabel,
  requiredLabel,
  autocomplete,
  inputmode,
} = Astro.props;

const showHint = Boolean(hint && !error);
const hintId = showHint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [errorId, hintId].filter(Boolean).join(' ') || undefined;
---

<div class="flex flex-col gap-1.5">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <label for={id} class="text-sm font-medium text-cdf-ink">
      {label}
    </label>
    {
      required && requiredLabel ? (
        <span class="text-xs font-medium text-cdf-muted">{requiredLabel}</span>
      ) : null
    }
    {
      !required && optionalLabel ? (
        <span class="text-xs font-medium text-cdf-muted">{optionalLabel}</span>
      ) : null
    }
  </div>

  <input
    id={id}
    name={name}
    type={type}
    value={value}
    placeholder={placeholder}
    autocomplete={autocomplete}
    inputmode={inputmode}
    required={required}
    aria-required={required}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={describedBy}
    class:list={[
      'w-full rounded-md border bg-white px-3.5 py-3 text-base text-cdf-ink shadow-sm transition placeholder:text-cdf-muted/70 md:text-sm',
      'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cdf-accent',
      error
        ? 'border-cdf-danger ring-1 ring-cdf-danger/20'
        : 'border-cdf-border hover:border-cdf-ink/25',
    ]}
  />

  {
    showHint ? (
      <p id={hintId} class="text-xs leading-relaxed text-cdf-muted">
        {hint}
      </p>
    ) : null
  }

  {
    error ? (
      <p id={errorId} class="text-xs font-medium text-cdf-danger" role="alert">
        {error}
      </p>
    ) : null
  }
</div>
