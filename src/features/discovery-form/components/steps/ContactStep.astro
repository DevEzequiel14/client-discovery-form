---
/**
 * Paso 1 — Contacto.
 * Shell Astro (progreso + título) + isla React con validación y persistencia.
 */
import StepProgress from '../StepProgress.astro';
import { ContactStepForm } from './ContactStepForm';
import { STEP_IDS } from '../../types/steps';
import type { Locale } from '../../../../i18n/locales';
import type { Messages } from '../../../../i18n/types';

type Props = {
  locale: Locale;
  messages: Messages;
  totalSteps?: number;
};

const { locale, messages, totalSteps = STEP_IDS.length } = Astro.props;
const step = messages.steps.contact;
const currentStep = 1;
---

<section
  class="mx-auto w-full max-w-xl space-y-8"
  aria-labelledby="contact-step-title"
>
  <StepProgress
    current={currentStep}
    total={totalSteps}
    progressLabel={messages.form.progressLabel}
    stepOfTemplate={messages.form.stepOf}
    currentStepTitle={step.title}
  />

  <header class="space-y-2">
    <h1
      id="contact-step-title"
      class="font-display text-3xl leading-tight text-cdf-ink md:text-4xl"
    >
      {step.title}
    </h1>
    <p class="max-w-prose text-base text-cdf-muted md:text-lg">
      {step.description}
    </p>
  </header>

  <ContactStepForm client:load locale={locale} />
</section>
