---
import { FormWizard } from '../../../features/discovery-form/components/FormWizard';
import FormLayout from '../../../layouts/FormLayout.astro';
import { LOCALES } from '../../../i18n/locales';
import { getMessages, isLocale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isLocale(lang)) {
  return Astro.redirect('/es/formulario', 302);
}

const messages = getMessages(lang);
---

<FormLayout
  locale={lang}
  title={messages.meta.formTitle}
  description={messages.meta.formDescription}
>
  <FormWizard client:load locale={lang} />
</FormLayout>
