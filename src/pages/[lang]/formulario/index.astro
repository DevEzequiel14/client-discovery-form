---
import ContactStep from '../../../features/discovery-form/components/steps/ContactStep.astro';
import FormLayout from '../../../layouts/FormLayout.astro';
import { LOCALES } from '../../../i18n/locales';
import { getMessages, isLocale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isLocale(lang)) {
  return Astro.redirect('/es/formulario', 302);
}

const messages = getMessages(lang);
---

<FormLayout
  locale={lang}
  title={messages.steps.contact.title}
  description={messages.steps.contact.description}
>
  <ContactStep locale={lang} messages={messages} />
</FormLayout>
