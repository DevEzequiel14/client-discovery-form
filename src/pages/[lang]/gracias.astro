---
import FormLayout from '../../layouts/FormLayout.astro';
import { LOCALES } from '../../i18n/locales';
import { getMessages, isLocale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isLocale(lang)) {
  return Astro.redirect('/es/gracias', 302);
}

const messages = getMessages(lang);
const reference = Astro.url.searchParams.get('ref');
const t = messages.thanks;
---

<FormLayout
  locale={lang}
  title={messages.meta.thanksTitle}
  description={messages.meta.thanksDescription}
>
  <section
    class="thanks-page mx-auto flex min-h-[70dvh] max-w-xl flex-col justify-center py-10"
  >
    <div class="space-y-8">
      <header class="thanks-hero space-y-3">
        <h1 class="font-display text-3xl leading-tight text-cdf-ink md:text-4xl">
          {t.headline}
        </h1>
        <p class="text-base leading-relaxed text-cdf-muted md:text-lg">
          {t.supporting}
        </p>
      </header>

      {
        reference ? (
          <p class="thanks-ref text-sm text-cdf-muted">
            <span class="font-medium text-cdf-ink">{t.referenceLabel}:</span>{' '}
            <span class="font-mono tracking-wide text-cdf-ink">{reference}</span>
          </p>
        ) : null
      }

      <div class="thanks-cta space-y-3">
        <a
          href={`/${lang}`}
          class="inline-flex min-h-11 w-fit items-center justify-center rounded-md bg-cdf-accent px-5 py-2.5 text-sm font-medium text-white transition hover:bg-cdf-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cdf-accent"
        >
          {t.ctaPrimary}
        </a>
        <p class="text-sm text-cdf-muted">{t.ctaNote}</p>
      </div>
    </div>
  </section>
</FormLayout>

<style>
  .thanks-hero {
    animation: thanks-rise 0.45s ease-out both;
  }

  .thanks-ref {
    animation: thanks-rise 0.45s ease-out 0.06s both;
  }

  .thanks-cta {
    animation: thanks-rise 0.45s ease-out 0.12s both;
  }

  @keyframes thanks-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thanks-hero,
    .thanks-ref,
    .thanks-cta {
      animation: none;
    }
  }
</style>
