---
import BaseLayout from './BaseLayout.astro';
import LanguageSwitcher from '../components/layout/LanguageSwitcher.astro';
import { getMessages, type Locale } from '../i18n';

type Props = {
  locale: Locale;
  title: string;
  description: string;
};

const { locale, title, description } = Astro.props;
const messages = getMessages(locale);
const pathname = Astro.url.pathname;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  brandLabel={messages.meta.brandLabel}
>
  <div class="min-h-dvh">
    <header class="mx-auto flex w-full max-w-5xl items-center justify-between px-5 py-5 md:px-8">
      <a
        href={`/${locale}`}
        class="font-display text-lg font-semibold tracking-tight text-cdf-ink"
      >
        {messages.meta.brandLabel}
      </a>
      <LanguageSwitcher locale={locale} pathname={pathname} />
    </header>
    <main class="mx-auto w-full max-w-5xl px-5 pb-16 pt-4 md:px-8">
      <slot />
    </main>
  </div>
</BaseLayout>
