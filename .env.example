# Public (available in the browser)
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never expose service role or Resend key to the client)
# 1) Run supabase/schema.sql in the Supabase SQL Editor
# 2) Paste Project URL + service_role key below
SUPABASE_SERVICE_ROLE_KEY=
# Resend: API key + verified from address + your inbox
RESEND_API_KEY=
RESEND_FROM_EMAIL=Client Discovery <noreply@yourdomain.com>
DISCOVERY_NOTIFY_EMAIL=you@example.com
